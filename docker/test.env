# Test environment configuration for the multi-camera branch.
# Loaded by the alarm scripts via $ENV_FILE (mounted at /etc/alarm-camera.env).

# environment name (S3 prefix + photo filename)
ENV=etuovi
# the location of stored video files
ALARM_VIDEO_DIR=/var/cache/alarm-video
# the prefix of alarm video file names
ALARM_VIDEO_FILE_PREFIX=out
# name of the video file containing information about currently handled alarm
FILE_NAME_ALARM=current-alarm
# filename extension of the file containing information about currently handled alarm
FILE_EXTENSION_ALARM=.mp4
# Filename of the snapshot photo taken in case of alarm
FILE_PHOTO="${ALARM_VIDEO_DIR}/${ENV}.jpg"
# Name of the MQTT queue, which gets the alarms (via ONVIF)
MQTT_QUEUE=etuovi-person
# The host running the MQTT
MQTT_HOST=broker
MQTT_USERNAME=test
MQTT_PASSWORD=test
# The username of camera
CAMERA_USERNAME=test
# The password of camera
CAMERA_PASSWORD=test
# The RTSP URL of the camera (not used in tests; recorder is disabled)
CAMERA_RTSP_URL=mock:8554/stream
# The URL for fetching snapshot from current camera recording
CAMERA_SNAPSHOT_URL="http://mock:8080/cgi-bin/api.cgi?cmd=Snap&channel=0&rs=sdaf"
# Delay in seconds before taking the snapshot (default: 0)
SNAPSHOT_DELAY=0
# The S3 bucket used to store the video files
S3_BUCKET=halyvideo
# AWS profile used for S3 operations (credentials written to ~/.aws by the entrypoint)
S3_PROFILE=alarm-video-s3
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Point the aws CLI at the local S3 server instead of real AWS
S3_ENDPOINT_URL=http://s3:8000
# Telegram bot token
TG_BOT_TOKEN=123456:TEST-BOT-TOKEN
# Telegram group id
TG_CHAT_ID=12345
# Telegram API base URL (mock in tests)
TG_API_URL=http://mock:8080
# Recording mode: continuous (always recording) or on-demand (record only on events)
RECORDING_MODE=continuous
# Duration of on-demand recording in seconds (only used when RECORDING_MODE=on-demand)
ON_DEMAND_DURATION=10
# Segment length in seconds for continuous recording (default: 10)
SEGMENT_TIME=10
# Restart ffmpeg if no new segment appears within this many seconds (default: 60)
STALL_TIMEOUT=60