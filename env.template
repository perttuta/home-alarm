# Environment template. Rename this. Use name like alarm-camera.env

# environment name
ENV=
# the location of stored video files
ALARM_VIDEO_DIR=/var/cache/alarm-video
# the prefix of alarm video file names
ALARM_VIDEO_FILE_PREFIX=out
# name of the video file containing information about currently handled alarm
FILE_NAME_ALARM=current-alarm
# filename extension of the file containing information about currently handled alarm
FILE_EXTENSION_ALARM=.mp4
# Filename of the snapshot photo taken in case of alarm
FILE_PHOTO="${ALARM_VIDEO_DIR}/${ENV}.jpg"
# Name of the MQTT queue, which gets the alarms (via ONVIF)
MQTT_QUEUE=
# The host running the MQTT
MQTT_HOST=
MQTT_USERNAME=
MQTT_PASSWORD=
# The username of camera
CAMERA_USERNAME=
# The password of camera
CAMERA_PASSWORD=
# The RTSP URL of the camera's main (4K clear) stream. For example:
# 192.168.1.123/h264Preview_01_main. Used for the short 4K clip recorded on
# alarm (and for on-demand recording).
CAMERA_RTSP_URL=
# The RTSP URL of the camera's fluent (sub) stream. For example:
# 192.168.1.123/h264Preview_01_sub. Continuously recorded to capture what
# happened before an alarm. Falls back to CAMERA_RTSP_URL when left empty.
# CAMERA_RTSP_FLUENT_URL=
# The URL for fetching snapshot from current camera recording
CAMERA_SNAPSHOT_URL=
# Delay in seconds before taking the snapshot (default: 0)
SNAPSHOT_DELAY=0
# The name / IP address of camera, for example: 192.168.1.123
# CAMERA_HOST=
# The S3 bucket used to store the video files
S3_BUCKET=
# Optional: S3-compatible endpoint URL (empty = real AWS). For example: http://localhost:8000
# S3_ENDPOINT_URL=
# Telegram bot token
TG_BOT_TOKEN=
# Telegram group id
TG_CHAT_ID=
# Optional: Telegram API base URL (empty = real Telegram). For example: http://localhost:8080
# TG_API_URL=
# Recording mode: continuous (always recording) or on-demand (record only on events)
# continuous: ffmpeg runs continuously, creates 10-second segments, copies latest on alarm
# on-demand: ffmpeg starts only when alarm triggered, records for specified duration
RECORDING_MODE=continuous
# Duration of on-demand recording in seconds (only used when RECORDING_MODE=on-demand)
ON_DEMAND_DURATION=10
# Duration of the 4K clip recorded on alarm in continuous mode (default: 10)
CLIP_DURATION=10
# Segment length in seconds for continuous recording (default: 10)
SEGMENT_TIME=10
# Restart ffmpeg if no new segment appears within this many seconds (default: 60)
STALL_TIMEOUT=60